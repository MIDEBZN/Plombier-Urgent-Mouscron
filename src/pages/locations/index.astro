---
import Layout from '../../layouts/Layout.astro';

const locations = [
  {
    name: "Mouscron Centre & Quartiers",
    postalCode: "7700",
    slug: "mouscron",
    time: "Départ prioritaire",
    tag: "Atelier & Dépôt d'Astreinte",
    description: "Intervention rapide dans l'hyper-centre, Grand-Place, gare SNCB, Le Tuquet, Le Mont-à-Leux, Le Risquons-Tout et Le Nouveau Monde.",
    landmarks: "Grand-Place, Gare de Mouscron, CHM, Boulevard des Alliés, N58",
    keyService: "Fuites encastrées, débouchage WC, remplacement robinetterie, chauffe-eau"
  },
  {
    name: "Luingne",
    postalCode: "7700",
    slug: "luingne",
    time: "Déplacement rapide",
    tag: "Entité Communale 7700",
    description: "Dépannage à Luingne Village, secteur de la Royère, Les Épinettes et abords de la Chaussée de Dottignies.",
    landmarks: "Place Saint-Amand, Échangeur N58, Chaussée de Luingne, Rue de la Royère",
    keyService: "Détartrage boiler, débouchage sterputs, pose d'adoucisseurs, fuites en cave"
  },
  {
    name: "Herseaux",
    postalCode: "7712",
    slug: "herseaux",
    time: "Déplacement rapide",
    tag: "Entité Communale 7712",
    description: "Prise en charge à Herseaux-Gare, Herseaux-Place, Les Ballons et abords de la frontière.",
    landmarks: "Gare d'Herseaux, Église Saint-Maur, Chaussée de Gand, Rue de Lannoy",
    keyService: "Canalisations grès et plomb, hydrocurage haute pression, mécanismes de chasse"
  },
  {
    name: "Dottignies",
    postalCode: "7711",
    slug: "dottignies",
    time: "Prise en charge directe",
    tag: "Cité de la Main 7711",
    description: "Couverture de la Place de la Main, Boulevard des Canadiens, Cité Claudel, Marais et bassins de l'Espierre.",
    landmarks: "Place de la Main, Sortie 5 E403 / A17, Boulevard des Canadiens (N511)",
    keyService: "Curage de fosses, sterputs d'extérieurs, canalisations d'évacuation de pavillons"
  },
  {
    name: "Estaimpuis",
    postalCode: "7730",
    slug: "estaimpuis",
    time: "Prise en charge directe",
    tag: "Commune Limitrophe Sud",
    description: "Dépannage d'urgence sur Néchin, Leers-Nord, Saint-Léger, Évregnies, Bailleul et Estaimbourg.",
    landmarks: "Maison Communale, N50 Chaussée de Tournai, Canal de Roubaix, Néchin",
    keyService: "Groupes hydrophores, assainissement individuel, débouchage de regards"
  },
  {
    name: "Comines-Warneton",
    postalCode: "7780",
    slug: "comines-warneton",
    time: "Liaison directe N58",
    tag: "Vallée de la Lys via N58",
    description: "Liaison directe par la voie rapide N58 vers Comines, Warneton, Bas-Warneton, Ploegsteert et Le Bizet.",
    landmarks: "Voie express N58, Grand-Place de Comines, Ploegsteert, Le Bizet",
    keyService: "Pompes vide-cave automatiques, clapets anti-retour, dépannage d'urgence"
  }
];
---

<Layout 
  title="Zones d'Intervention Plombier : Mouscron, Luingne, Herseaux, Dottignies & Alentours"
  description="Zones d'intervention de votre plombier d'urgence à Mouscron (7700), Luingne, Herseaux, Dottignies, Estaimpuis et Comines-Warneton. Dépannage rapide 24h/24 et 7j/7."
  canonicalPath="/locations"
  breadcrumbs={[
    { name: "Accueil", url: "/" },
    { name: "Zones d'Intervention", url: "/locations" }
  ]}
>
  <!-- Hero Section -->
  <section class="bg-brand-navy text-white py-14 lg:py-20 relative overflow-hidden" aria-labelledby="locations-hub-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <span class="text-xs font-bold tracking-widest uppercase text-brand-red mb-3 block">Rayon d'Action Territorial</span>
      <h1 id="locations-hub-heading" class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
        Zones d'Intervention Plomberie à Mouscron et Communes Voisines
      </h1>
      <p class="text-base sm:text-lg text-gray-300 max-w-3xl leading-relaxed mb-8">
        Basé au cœur de l'agglomération mouscronnoise, notre service d'astreinte déploie ses techniciens 24h/24 et 7j/7 dans les 4 entités communales du Grand Mouscron ainsi que dans les communes voisines de Wallonie picarde. Délai indicatif précisé dès votre appel.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="tel:+32465470070" class="px-7 py-4 bg-brand-red hover:bg-brand-redHover font-black text-sm rounded-xl text-white shadow-xl transition inline-flex items-center justify-center gap-2" aria-label="Appeler notre permanence d'urgence au 0465 47 00 70">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
          </svg>
          Urgence Immédiate : 0465 47 00 70
        </a>
        <a href="/contact" class="px-7 py-4 bg-white/10 hover:bg-white/20 border border-white/20 font-bold text-sm rounded-xl text-white transition text-center">
          Demande de Devis en Ligne
        </a>
      </div>
    </div>
  </section>

  <!-- Summary Cards Grid -->
  <section class="py-16 bg-white border-b border-brand-border" aria-labelledby="communes-grid-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <h2 id="communes-grid-heading" class="text-3xl font-extrabold text-brand-navy tracking-tight">
          Sélectionnez Votre Secteur pour Découvrir Nos Prestations
        </h2>
        <p class="text-base text-brand-muted mt-3">
          Chaque commune bénéficie d'une astreinte d'urgence, de pièces adaptées aux spécificités de son habitat et d'une tarification claire avant intervention.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {locations.map((loc) => (
          <article class="bg-brand-surface rounded-2xl border border-brand-border p-7 flex flex-col justify-between hover:shadow-lg transition-all">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full bg-brand-navy text-white text-xs font-bold uppercase tracking-wider">
                  {loc.postalCode}
                </span>
                <span class="text-xs font-bold text-brand-red bg-brand-red/10 px-2.5 py-1 rounded-md">
                  {loc.time}
                </span>
              </div>
              <div>
                <span class="text-[11px] font-bold uppercase tracking-wider text-brand-red block mb-1">{loc.tag}</span>
                <h3 class="text-xl font-bold text-brand-navy">
                  <a href={`/locations/${loc.slug}`} class="hover:text-brand-red transition-colors">
                    {loc.name}
                  </a>
                </h3>
              </div>
              <p class="text-xs text-brand-muted leading-relaxed">
                {loc.description}
              </p>
              <div class="space-y-2 pt-2 border-t border-brand-border text-xs">
                <div>
                  <strong class="text-brand-navy block mb-0.5">Repères géographiques :</strong>
                  <span class="text-brand-muted">{loc.landmarks}</span>
                </div>
                <div>
                  <strong class="text-brand-navy block mb-0.5">Interventions fréquentes :</strong>
                  <span class="text-brand-muted">{loc.keyService}</span>
                </div>
              </div>
            </div>
            <div class="pt-6">
              <a 
                href={`/locations/${loc.slug}`} 
                class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-brand-navy hover:bg-brand-red text-white text-xs font-bold rounded-xl transition-colors shadow-xs"
              >
                Découvrir la Zone {loc.name.split(' ')[0]}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Access Overview Table -->
  <section class="py-16 bg-brand-surface" aria-labelledby="times-table-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold tracking-widest uppercase text-brand-red mb-2 block">Desserte Locale</span>
        <h2 id="times-table-heading" class="text-3xl font-extrabold text-brand-navy tracking-tight">
          Secteurs Couverts & Axes d'Accès Principaux
        </h2>
        <p class="text-base text-brand-muted mt-3 leading-relaxed">
          Nos véhicules d'intervention sont positionnés à proximité des grands axes de circulation (N58, N511, E403) pour rejoindre rapidement les différents quartiers.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left bg-white rounded-2xl border border-brand-border shadow-xs overflow-hidden">
          <thead class="bg-brand-navy text-white text-xs uppercase tracking-wider">
            <tr>
              <th class="py-4 px-6">Commune / Secteur</th>
              <th class="py-4 px-6">Code Postal</th>
              <th class="py-4 px-6">Modalité de Déplacement</th>
              <th class="py-4 px-6">Disponibilité</th>
              <th class="py-4 px-6">Axe d'Accès Privilégié</th>
            </tr>
          </thead>
          <tbody class="text-sm divide-y divide-brand-border">
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Mouscron Centre & Quartiers</td>
              <td class="py-4 px-6 text-brand-muted">7700</td>
              <td class="py-4 px-6 font-bold text-brand-red">Départ prioritaire immédiat</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">Rue de Menin / Boulevard des Alliés</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Luingne</td>
              <td class="py-4 px-6 text-brand-muted">7700</td>
              <td class="py-4 px-6 font-bold text-brand-red">Déplacement rapide</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">Chaussée de Luingne / N58</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Herseaux</td>
              <td class="py-4 px-6 text-brand-muted">7712</td>
              <td class="py-4 px-6 font-bold text-brand-red">Déplacement rapide</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">Chaussée de Gand / Rue de Lannoy</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Dottignies</td>
              <td class="py-4 px-6 text-brand-muted">7711</td>
              <td class="py-4 px-6 font-bold text-brand-navy">Prise en charge directe</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">E403 Sortie 5 / N511 Boulevard des Canadiens</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Estaimpuis (Néchin, Leers-Nord, Saint-Léger)</td>
              <td class="py-4 px-6 text-brand-muted">7730</td>
              <td class="py-4 px-6 font-bold text-brand-navy">Prise en charge directe</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">N50 Chaussée de Tournai / Axe Néchin</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-brand-navy">Comines-Warneton (Ploegsteert, Le Bizet)</td>
              <td class="py-4 px-6 text-brand-muted">7780</td>
              <td class="py-4 px-6 font-bold text-brand-navy">Liaison express N58</td>
              <td class="py-4 px-6 text-brand-darkText">24h/24 et 7j/7</td>
              <td class="py-4 px-6 text-xs text-brand-muted">Voie express N58 directe</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-brand-navy text-white text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        Votre Commune se Situe dans Notre Rayon d'Action ?
      </h2>
      <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto">
        Nos techniciens sont joignables dès maintenant. Appelez notre permanence pour une intervention d'urgence ou transmettez votre demande par formulaire.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4 pt-2">
        <a href="tel:+32465470070" class="px-8 py-4 bg-brand-red hover:bg-brand-redHover font-black text-base rounded-xl text-white shadow-xl transition" aria-label="Appeler l'astreinte au 0465 47 00 70">
          Ligne Directe 24/7 : 0465 47 00 70
        </a>
        <a href="/contact" class="px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/20 font-bold text-base rounded-xl text-white transition">
          Demander un Devis Gratuit
        </a>
      </div>
    </div>
  </section>
</Layout>
