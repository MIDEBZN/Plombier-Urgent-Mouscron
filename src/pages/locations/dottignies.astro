<Layout 
  title="Plombier Dottignies (7711) : Dépannage d'Urgence 24h/24 & 7j/7"
  description="Plombier d'urgence à Dottignies (7711). Dépannage rapide pour fuite d'eau, débouchage canalisation, chauffe-eau, chaudière et curage. Devis gratuit avant travaux."
  canonicalPath="/locations/dottignies"
  breadcrumbs={[
    { name: "Accueil", url: "/" },
    { name: "Zones d'Intervention", url: "/locations" },
    { name: "Dottignies", url: "/locations/dottignies" }
  ]}
>
  <!-- Hero Section -->
  <section class="bg-brand-navy text-white py-14 lg:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-wrap items-center gap-2 mb-4 text-xs font-bold uppercase tracking-wider text-brand-red">
