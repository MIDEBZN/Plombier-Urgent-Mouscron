---
import Layout from '../layouts/Layout.astro';
import TrustBadgesStrip from '../components/TrustBadgesStrip.astro';
import ResponseTimeStats from '../components/ResponseTimeStats.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import CustomerTestimonials from '../components/CustomerTestimonials.astro';
---

<Layout 
  title="Plombier à Mouscron (7700) | Dépannage Plomberie d'Urgence 24/7"
  description="Plombier d'urgence à Mouscron (7700) disponible 24h/24 et 7j/7. Dépannage rapide pour fuite d'eau, débouchage canalisation, boiler et sanitaires. Devis clair avant travaux."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="relative bg-brand-navy text-white overflow-hidden py-14 lg:py-20" aria-labelledby="hero-heading">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#FF4304_1px,transparent_1px)] [background-size:20px_20px]"></div>
    <div class="absolute -right-24 -top-24 w-96 h-96 bg-brand-red/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Left Column -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/15 text-xs font-semibold text-white mb-6">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-red opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-red"></span>
            </span>
            <span class="text-amber-400 font-bold">Astreinte 24/7</span>
            <span class="text-white/40">|</span>
            <span class="tracking-wide uppercase text-[11px]">Artisans Plombiers à Mouscron</span>
          </div>

          <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight sm:leading-none text-white mb-6">
            Plombier d'Urgence à <span class="text-brand-red">Mouscron</span> (7700)
          </h1>

          <p class="text-lg sm:text-xl text-gray-300 font-body mb-6 leading-relaxed max-w-2xl">
            Fuite d'eau importante, WC bouché, canalisation qui refoule ou panne de chauffe-eau ? Nos techniciens interviennent rapidement à Mouscron et dans les entités voisines pour stopper le sinistre et réparer votre installation.
          </p>

          <!-- Key Checkpoints -->
          <div class="space-y-3 mb-8">
            <div class="flex items-center space-x-3 text-sm font-medium text-gray-200">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center font-bold text-xs">✓</span>
              <span><strong>Permanence 24h/24 & 7j/7</strong> : Prise en charge d'urgence, week-ends et jours fériés inclus</span>
            </div>
            <div class="flex items-center space-x-3 text-sm font-medium text-gray-200">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center font-bold text-xs">✓</span>
              <span><strong>Tarif annoncé avant réparation</strong> : Devis clair validé sur place sans mauvaise surprise</span>
            </div>
            <div class="flex items-center space-x-3 text-sm font-medium text-gray-200">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center font-bold text-xs">✓</span>
              <span><strong>Facture détaillée conforme</strong> : Rapport pour dossier d'assurance dégât des eaux</span>
            </div>
          </div>

          <!-- Hero Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-brand-red hover:bg-brand-redHover text-white text-base font-bold shadow-lg shadow-brand-red/30 transition transform hover:-translate-y-0.5" href="tel:+32465470070" aria-label="Appeler notre service de garde au 0465 47 00 70">
              <svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
              </svg>
              Appel d'Urgence : 0465 47 00 70
            </a>
            <a class="inline-flex items-center justify-center px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 text-base font-semibold backdrop-blur-sm transition" href="#devis-contact">
              Demander un Devis en Ligne
            </a>
          </div>

          <p class="text-xs text-gray-400">
            Dépannages à Mouscron (7700), Luingne, Herseaux, Dottignies, Estaimpuis et Comines-Warneton.
          </p>
        </div>

        <!-- Hero Right: Emergency Direct Action & Safety Guidance Card -->
        <div class="lg:col-span-5">
          <div class="bg-white text-brand-darkText rounded-2xl shadow-2xl border border-brand-border p-6 sm:p-8 space-y-5">
            <div>
              <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-extrabold uppercase tracking-wide bg-brand-red/10 text-brand-red mb-2">
                Astreinte Directe Locale
              </span>
              <h2 class="text-2xl font-bold text-brand-navy">Urgence Plomberie Mouscron</h2>
              <p class="text-brand-muted text-xs sm:text-sm mt-1">
                Ligne directe ouverte 24h/24 pour planifier un départ immédiat vers votre adresse.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-brand-surface border border-brand-border space-y-2">
              <span class="text-xs uppercase tracking-wider text-brand-muted font-bold block">
                Téléphone d'astreinte 24h/24 :
              </span>
              <a href="tel:+32465470070" class="text-2xl sm:text-3xl font-black text-brand-navy hover:text-brand-red transition-colors block">
                0465 47 00 70
              </a>
              <span class="text-xs text-emerald-700 font-semibold block flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                Technicien joignable en direct
              </span>
            </div>

            <!-- Immediate Safety Reflexes (Competitor gap / GEO value) -->
            <div class="space-y-2.5 pt-2 border-t border-brand-border">
              <span class="text-xs font-bold text-brand-navy uppercase tracking-wider block">
                Gestes d'urgence avant l'arrivée :
              </span>
              <ul class="text-xs text-brand-muted space-y-2">
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold">1.</span>
                  <span><strong>Fermez la vanne d'arrêt générale :</strong> Elle se situe généralement juste avant votre compteur d'eau SWDE.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold">2.</span>
                  <span><strong>Sécurité électrique :</strong> Coupez le disjoncteur du secteur concerné si l'eau s'infiltre près de prises ou appareils.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-brand-red font-bold">3.</span>
                  <span><strong>Ne forcez pas :</strong> Évitez de serrer excessivement un écrou ou un robinet grippé pour ne pas casser le pas de vis.</span>
                </li>
              </ul>
            </div>

            <div class="pt-2 border-t border-brand-border flex flex-col gap-2.5">
              <a 
                href="https://wa.me/32465470070?text=Bonjour,%20j'ai%20une%20urgence%20plomberie%20%C3%A0%20Mouscron." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full py-3 px-4 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold text-xs flex items-center justify-center gap-2 shadow-xs transition"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.04 2a9.9 9.9 0 00-8.48 15.06L2 22l5.09-1.52A9.94 9.94 0 1012.04 2zm5.46 12.4c-.23-.12-1.36-.67-1.57-.75-.21-.08-.36-.12-.52.12-.15.23-.6.75-.73.9-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.15-1.36-1.28-1.59-.13-.23-.01-.35.1-.47.1-.1.23-.27.35-.4.12-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.44c-.15 0-.4.06-.61.29-.21.23-.8.78-.8 1.91s.82 2.22.94 2.38c.12.15 1.62 2.48 3.95 3.48.55.24.98.38 1.32.48.55.18 1.05.15 1.45.09.44-.07 1.36-.55 1.55-1.09.19-.53.19-.99.13-1.09-.05-.1-.2-.15-.43-.27zM12.04 20.18c-1.62 0-3.2-.44-4.58-1.27l-.33-.2-3.02.9.91-2.95-.21-.34a8.26 8.26 0 1115.4-4.34 8.2 8.2 0 01-8.17 8.2z"/>
                </svg>
                Envoyer une Photo de la Panne par WhatsApp
              </a>
              <p class="text-[11px] text-brand-muted text-center">
                Devis écrit et accord préalable systématique avant intervention.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges Strip Section -->
  <TrustBadgesStrip />

  <!-- Problem Triage Grid Section -->
  <section class="py-16 bg-brand-surface border-b border-brand-border" aria-labelledby="services-overview">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold tracking-widest uppercase text-brand-red mb-2 block">Nos Solutions d'Urgence</span>
        <h2 id="services-overview" class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">
          Pannes et Dépannages Pris en Charge à Mouscron
        </h2>
        <p class="text-brand-muted mt-3 text-base">
          Nos techniciens disposent de véhicules équipés pour intervenir immédiatement sur les pannes sanitaires courantes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1: Fuites -->
        <article class="bg-white rounded-2xl overflow-hidden border border-brand-border shadow-xs hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden bg-gray-100 relative">
              <img 
                src="/images/service-fuite.webp" 
                alt="Réparation de fuite d'eau urgente à Mouscron" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                decoding="async"
                width="800" 
                height="450" 
              />
              <span class="absolute top-3 left-3 bg-brand-navy/90 backdrop-blur-xs text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-white/10">
                Urgence Eau 24/7
              </span>
            </div>
            <div class="p-6 sm:p-7">
              <h3 class="text-xl font-bold text-brand-navy mb-2.5 group-hover:text-brand-red transition-colors">
                Réparation de Fuite d'Eau
              </h3>
              <p class="text-brand-muted text-sm leading-relaxed mb-4">
                Tuyau cuivre ou multicouche percé, fuite sous évier, robinet d'arrêt défaillant, suintement encastré. Colmatage et remplacement des sections endommagées.
              </p>
              <ul class="text-xs text-brand-darkText space-y-2 mb-6">
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Localisation de fuite non destructive</li>
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Justificatif technique en cas de surconsommation</li>
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Rapport détaillé pour assurance dégât des eaux</li>
              </ul>
            </div>
          </div>
          <div class="px-6 pb-6 sm:px-7 sm:pb-7">
            <a class="inline-flex items-center text-sm font-bold text-brand-red hover:underline" href="/services/depannage-urgence">
              En savoir plus sur le dépannage de fuites &rarr;
            </a>
          </div>
        </article>

        <!-- Card 2: Debouchage -->
        <article class="bg-white rounded-2xl overflow-hidden border border-brand-border shadow-xs hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden bg-gray-100 relative">
              <img 
                src="/images/service-debouchage.webp" 
                alt="Débouchage canalisation et WC à Mouscron" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                decoding="async"
                width="800" 
                height="450" 
              />
              <span class="absolute top-3 left-3 bg-brand-navy/90 backdrop-blur-xs text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-white/10">
                Assainissement Express
              </span>
            </div>
            <div class="p-6 sm:p-7">
              <h3 class="text-xl font-bold text-brand-navy mb-2.5 group-hover:text-brand-navy transition-colors">
                Débouchage Canalisation & WC
              </h3>
              <p class="text-brand-muted text-sm leading-relaxed mb-4">
                Toilettes qui débordent, évier bloqué, odeurs d'égout persistantes ou sterput qui refoule. Débouchage mécanique au furet et hydrocurage sous pression.
              </p>
              <ul class="text-xs text-brand-darkText space-y-2 mb-6">
                <li class="flex items-center gap-2"><span class="text-brand-navy font-bold">+</span> Désobstruction rapide de cuvettes WC et siphons</li>
                <li class="flex items-center gap-2"><span class="text-brand-navy font-bold">+</span> Curage haute pression pour conduites principales</li>
                <li class="flex items-center gap-2"><span class="text-brand-navy font-bold">+</span> Inspection par caméra vidéo si récidive</li>
              </ul>
            </div>
          </div>
          <div class="px-6 pb-6 sm:px-7 sm:pb-7">
            <a class="inline-flex items-center text-sm font-bold text-brand-navy hover:underline" href="/services/debouchage">
              En savoir plus sur le débouchage &rarr;
            </a>
          </div>
        </article>

        <!-- Card 3: Boiler -->
        <article class="bg-white rounded-2xl overflow-hidden border border-brand-border shadow-xs hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden bg-gray-100 relative">
              <img 
                src="/images/service-boiler.webp" 
                alt="Dépannage boiler et chauffe-eau à Mouscron" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                decoding="async"
                width="800" 
                height="450" 
              />
              <span class="absolute top-3 left-3 bg-brand-navy/90 backdrop-blur-xs text-white text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-white/10">
                Eau Chaude Sanitaire
              </span>
            </div>
            <div class="p-6 sm:p-7">
              <h3 class="text-xl font-bold text-brand-navy mb-2.5 group-hover:text-brand-red transition-colors">
                Dépannage Boiler & Chauffe-Eau
              </h3>
              <p class="text-brand-muted text-sm leading-relaxed mb-4">
                Plus d'eau chaude, groupe de sécurité qui coule en permanence ou disjonction électrique. Diagnostic de panne, détartrage et remplacement de pièces.
              </p>
              <ul class="text-xs text-brand-darkText space-y-2 mb-6">
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Diagnostic résistance, thermostat et sécurité</li>
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Détartrage pour contrer l'eau très dure de Mouscron</li>
                <li class="flex items-center gap-2"><span class="text-brand-red font-bold">+</span> Remplacement rapide par matériel équivalent</li>
              </ul>
            </div>
          </div>
          <div class="px-6 pb-6 sm:px-7 sm:pb-7">
            <a class="inline-flex items-center text-sm font-bold text-brand-red hover:underline" href="/services/chauffage-chaudieres">
              En savoir plus sur les chauffe-eau &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Response Time & Operational Readiness Section -->
  <ResponseTimeStats />

  <!-- Local Authority Section -->
  <section class="py-16 bg-white" aria-labelledby="why-local-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold tracking-widest uppercase text-brand-red block">Proximité & Clarté</span>
          <h2 id="why-local-heading" class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">
            Pourquoi Choisir un Plombier Établi à Mouscron ?
          </h2>
          <p class="text-brand-muted text-base leading-relaxed">
            Sur internet, de nombreuses plateformes d'intermédiation se font passer pour des artisans locaux alors qu'elles redistribuent les demandes à des intervenants distants avec des marges élevées. Nous intervenons directement depuis notre implantation à Mouscron avec des tarifs transparents.
          </p>
          <div class="space-y-4 pt-2">
            <div class="p-4 rounded-xl border border-brand-border bg-brand-surface flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-brand-red/10 text-brand-red font-bold flex items-center justify-center shrink-0">1</div>
              <div>
                <h3 class="font-bold text-brand-navy text-sm">Déplacement direct depuis Mouscron</h3>
                <p class="text-xs text-brand-muted mt-0.5">Nos véhicules partent de l'entité mouscronnoise, garantissant un départ rapide sans intermédiaires.</p>
              </div>
            </div>
            <div class="p-4 rounded-xl border border-brand-border bg-brand-surface flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-brand-red/10 text-brand-red font-bold flex items-center justify-center shrink-0">2</div>
              <div>
                <h3 class="font-bold text-brand-navy text-sm">Devis clair et validé avant travaux</h3>
                <p class="text-xs text-brand-muted mt-0.5">Le tarif de l'intervention et des fournitures vous est précisé après diagnostic, avant toute réparation.</p>
              </div>
            </div>
            <div class="p-4 rounded-xl border border-brand-border bg-brand-surface flex items-start gap-4">
              <div class="w-8 h-8 rounded-full bg-brand-red/10 text-brand-red font-bold flex items-center justify-center shrink-0">3</div>
              <div>
                <h3 class="font-bold text-brand-navy text-sm">Facture conforme avec taux de TVA légal</h3>
                <p class="text-xs text-brand-muted mt-0.5">Application du taux de 6% pour les logements privés de plus de 10 ans selon la réglementation belge, ou taux normal de 21%.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 bg-brand-navy text-white rounded-3xl p-8 sm:p-10 shadow-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-brand-red/10 rounded-full blur-2xl"></div>
          <h3 class="text-2xl font-black mb-4">Notre Charte de Transparence</h3>
          <p class="text-sm text-gray-300 leading-relaxed mb-6">
            Ce que nous nous engageons à respecter lors de chaque visite :
          </p>
          <ul class="space-y-3.5 text-sm">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center text-xs font-bold">✓</span>
              <span>Devis écrit préalable avant tout remplacement de pièce</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center text-xs font-bold">✓</span>
              <span>Aucun frais de dossier imprévu ni facturation cachée</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center text-xs font-bold">✓</span>
              <span>Explication pédagogique de la cause de la panne</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand-red/20 text-brand-red flex items-center justify-center text-xs font-bold">✓</span>
              <span>Ligne téléphonique directe joignable 24h/24 sans surtaxe</span>
            </li>
          </ul>

          <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <span class="text-xs text-gray-400 block">Permanence téléphonique :</span>
              <span class="text-2xl font-black text-white">0465 47 00 70</span>
            </div>
            <a href="tel:+32465470070" class="px-5 py-3 rounded-xl bg-brand-red hover:bg-brand-redHover font-bold text-sm text-white transition" aria-label="Appeler un technicien">
              Appeler un technicien
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Map Section -->
  <ServiceAreaMap />

  <!-- Indicative Pricing Section -->
  <section class="py-16 bg-brand-surface border-t border-brand-border" aria-labelledby="estimator-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-bold tracking-widest uppercase text-brand-red mb-2 block">Transparence Tarifaire</span>
        <h2 id="estimator-heading" class="text-3xl font-extrabold text-brand-navy tracking-tight">
          Grille Tarifaire Indicative à Mouscron
        </h2>
        <p class="text-sm text-brand-muted mt-2">
          Tarifs indicatifs pour interventions courantes en journée. Un devis clair est remis sur place avant toute réparation.
        </p>
      </div>

      <div class="bg-white rounded-2xl border border-brand-border shadow-md overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead class="bg-brand-navy text-white uppercase text-xs tracking-wider">
              <tr>
                <th class="py-4 px-6">Prestation de plomberie</th>
                <th class="py-4 px-6">Modalité</th>
                <th class="py-4 px-6">Tarif indicatif HTVA</th>
                <th class="py-4 px-6">Avec TVA 6% (logement +10 ans)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-brand-border text-brand-darkText">
              <tr class="hover:bg-brand-surface/60 transition">
                <td class="py-4 px-6 font-semibold">Déplacement et diagnostic initial à Mouscron</td>
