---
import Layout from '../../layouts/Layout.astro';
import { getAllArticles } from '../../data/articles';

const articles = getAllArticles();
const featuredArticle = articles[0];
---

<Layout 
  title="Blog Plomberie Mouscron | Les 20 Guides Conseils & Urgences 2026"
  description="Consultez nos 20 guides experts et fiches conseils pour vos urgences et travaux de plomberie a Mouscron. Tarifs 2026, debouchage, fuites et boilers."
  canonicalPath="/blog"
>
  <!-- Hero Section -->
  <header class="bg-brand-navy text-white py-14 lg:py-18 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center sm:text-left">
      <span class="text-xs font-bold tracking-widest uppercase text-brand-red mb-3 block">Base de Connaissances Pratiques</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Guides Conseils & Urgences Plomberie a Mouscron
      </h1>
      <p class="text-base sm:text-lg text-gray-300 max-w-3xl leading-relaxed">
        Retrouvez nos reponses d'experts aux 20 questions incontournables des proprietaires et locataires du Grand Mouscron : tarifs officiels 2026, depannage nocturne, reglementation belge et aides d'urgence.
      </p>
    </div>
  </header>

  <!-- Featured Article Banner (Topic 1) -->
  <section class="py-12 bg-white border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-red block mb-4">Article Recommande</span>
      <article class="p-6 sm:p-8 rounded-3xl bg-brand-surface border-2 border-brand-red/30 shadow-md flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="space-y-3 max-w-3xl">
          <div class="flex items-center space-x-2 text-xs">
            <span class="px-2.5 py-0.5 rounded-full bg-brand-red text-white font-bold">{featuredArticle.category}</span>
            <span class="text-brand-muted">Publie en {featuredArticle.publishedDate}</span>
            <span class="text-brand-muted">Temps de lecture : {featuredArticle.readTime}</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy hover:text-brand-red transition">
            <a href={`/blog/${featuredArticle.slug}`}>
              {featuredArticle.title}
            </a>
          </h2>
          <p class="text-sm text-brand-muted leading-relaxed">
            {featuredArticle.metaDescription}
          </p>
        </div>
        <a 
          href={`/blog/${featuredArticle.slug}`} 
          class="px-6 py-3.5 rounded-xl bg-brand-red hover:bg-brand-redHover text-white font-bold text-sm shadow-md transition shrink-0"
        >
          Consulter le Guide &rarr;
        </a>
      </article>
    </div>
  </section>

  <!-- 20 Complete Articles Grid -->
  <section class="py-16 bg-brand-surface" aria-labelledby="all-topics-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-red block mb-1">Index des 20 Dossiers</span>
        <h2 id="all-topics-heading" class="text-3xl font-extrabold text-brand-navy tracking-tight">
          L'Integralite de nos 20 Guides Sanitaires et d'Urgence a Mouscron
        </h2>
        <p class="text-sm text-brand-muted mt-2">
          Chaque dossier apporte une reponse technique verifiable, des grilles de prix chiffrees et des conseils conformes a la legislation wallonne.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((item) => (
          <article class="bg-white p-6 rounded-2xl border border-brand-border flex flex-col justify-between shadow-2xs hover:shadow-md hover:border-brand-red/40 transition">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-brand-red bg-brand-red/10 px-2 py-0.5 rounded">{item.category}</span>
                <span class="text-brand-muted">{item.readTime}</span>
              </div>
              <h3 class="text-base font-bold text-brand-navy leading-snug">
                <a href={`/blog/${item.slug}`} class="hover:text-brand-red transition">
                  {item.title}
                </a>
              </h3>
              <p class="text-xs text-brand-muted leading-relaxed line-clamp-3">
                {item.metaDescription}
              </p>
            </div>

            <div class="pt-4 border-t border-brand-border mt-4 flex items-center justify-between text-xs">
              <a href={`/blog/${item.slug}`} class="font-bold text-brand-red hover:underline flex items-center gap-1">
                <span>Lire l'article</span>
                <span>&rarr;</span>
              </a>
              <span class="font-mono text-gray-400 text-[10px]">Dossier #{item.id}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Emergency Support Banner -->
  <section class="py-14 bg-brand-navy text-white text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold">Une Urgence Plomberie a Mouscron ou Environs ?</h2>
      <p class="text-sm text-gray-300">
        Nos artisans plombiers de permanence interviennent 24h/24 et 7j/7 en 20 a 30 minutes a Mouscron, Luingne, Herseaux et Dottignies.
      </p>
      <div class="pt-2">
        <a href="tel:+3256980244" class="inline-flex items-center px-8 py-4 bg-brand-red hover:bg-brand-redHover font-black text-base rounded-xl text-white shadow-xl transition">
          Ligne Directe 24/7 : 056 98 02 44
        </a>
      </div>
    </div>
  </section>
</Layout>
