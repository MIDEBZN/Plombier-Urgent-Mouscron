---
import '../styles/global.css';
import TrustGuarantees from '../components/TrustGuarantees.astro';
import GlobalContactSection from '../components/GlobalContactSection.astro';
import StickyCallButton from '../components/StickyCallButton.astro';
import WhatsAppLiveChat from '../components/WhatsAppLiveChat.astro';
import GoogleMapEmbed from '../components/GoogleMapEmbed.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schemaType?: string;
  hideGlobalContact?: boolean;
  preloadImage?: string;
}

const { 
  title, 
  description, 
  canonicalPath = '',
  schemaType = 'Plumber',
  hideGlobalContact = false,
  preloadImage
} = Astro.props;

const siteUrl = 'https://www.plombierurgentmouscron.be';
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteUrl).toString();

const schemaData = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": "Plombier Urgent Mouscron",
  "url": canonicalURL,
  "telephone": "+32490067245",
  "email": "contact@plombierurgentmouscron.be",
  "priceRange": "EUR",
  "image": "https://www.plombierurgentmouscron.be/og-image.webp",
  "description": description,
  "foundingDate": "2011",
  "hasCredential": [
    "Habilitation Gaz G1 et G2 Region Wallonne Cerga",
    "Certification Diagnostic Periodique PEB et Chauffage",
    "Certification Securite sur Chantier VCA",
    "Affiliation Buildwise CSTC Centre Scientifique et Technique de la Construction"
  ],
  "award": "Plus de 15 ans d'experience continue a Mouscron",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rue de la Royenne 45",
    "addressLocality": "Mouscron",
    "postalCode": "7700",
    "addressRegion": "Hainaut",
    "addressCountry": "BE"
  },
  "hasMap": "https://maps.app.goo.gl/4C3AtbpBCvHqD56n7",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 50.7444,
    "longitude": 3.2183
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Mouscron", "postalCode": "7700" },
    { "@type": "City", "name": "Luingne", "postalCode": "7700" },
    { "@type": "City", "name": "Herseaux", "postalCode": "7712" },
    { "@type": "City", "name": "Dottignies", "postalCode": "7711" },
    { "@type": "City", "name": "Estaimpuis", "postalCode": "7730" },
    { "@type": "City", "name": "Tourcoing", "postalCode": "59200" },
    { "@type": "City", "name": "Comines-Warneton", "postalCode": "7780" }
  ],
  "sameAs": []
};
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#001621" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="shortcut icon" href="/favicon.ico" />
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_BE" />
  <meta property="og:site_name" content="Plombier Urgent Mouscron" />
  <meta property="og:image" content="https://www.plombierurgentmouscron.be/og-image.webp" />

  <!-- Preconnect & DNS-Prefetch for Google Fonts -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
  )}

  <!-- Critical Above-Fold CSS (Inlined for instant FCP & LCP) -->
  <style is:inline>
    :root {
      --color-brand-navy: #001621;
      --color-brand-darknavy: #00111A;
      --color-brand-red: #FF4304;
      --color-brand-redHover: #E03800;
      --color-brand-surface: #F5F7FA;
      --color-brand-border: #E4E9F0;
      --color-brand-darkText: #172033;
      --color-brand-muted: #5E6878;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    *, *::before, *::after {
      box-sizing: border-box;
    }
    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }
    body {
      margin: 0;
      font-family: var(--font-sans);
      color: var(--color-brand-darkText);
      background-color: #FFFFFF;
      line-height: 1.5;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    img {
      max-width: 100%;
      height: auto;
      display: block;
    }
    button, a, input, select, textarea {
      touch-action: manipulation;
    }
    aside[aria-label="Informations de garde"] {
      background-color: #001621;
      color: #FFFFFF;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    header.sticky {
      position: sticky;
      top: 0;
      z-index: 40;
      background-color: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid #E4E9F0;
    }
    #mobile-nav-menu.hidden {
      display: none;
    }
    .pulse-dot {
      animation: pulse-ring 2s infinite ease-in-out;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.4; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    @supports (content-visibility: auto) {
      .cv-auto {
        content-visibility: auto;
        contain-intrinsic-size: 1px 700px;
      }
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body class="bg-white text-brand-darkText antialiased flex flex-col min-h-screen">
  <!-- Top Announcement Bar -->
  <aside class="bg-brand-navy text-white text-xs md:text-sm py-2.5 px-4 border-b border-white/10" aria-label="Informations de garde">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center flex-wrap justify-center sm:justify-start gap-3">
        <span class="inline-flex items-center text-brand-red font-bold uppercase tracking-wider text-[11px] bg-brand-red/10 px-2 py-0.5 rounded">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-red mr-1.5 pulse-dot"></span>
          Astreinte 24h/24 et 7j/7
        </span>
        <span class="hidden md:inline text-gray-300">15+ Ans d'Experience | Certifie Gaz G1/G2, PEB & VCA</span>
        <span class="text-amber-400 font-medium">Agree Toutes Assurances | Arrivee en 20-30 min</span>
      </div>
      <div class="flex items-center space-x-5 text-gray-300">
        <span class="hidden lg:inline text-xs text-gray-400">Entreprise certifiee & agreee</span>
        <a class="font-bold text-white hover:text-brand-red transition-colors flex items-center gap-1.5" href="tel:+32490067245">
          <svg class="w-3.5 h-3.5 text-brand-red" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
          </svg>
          0490 06 72 45
        </a>
      </div>
    </div>
  </aside>

  <!-- Sticky Header Navigation -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo (Square at the left corner) -->
        <a class="flex items-center shrink-0 group py-1" href="/" aria-label="Page d'accueil Plombier Urgent Mouscron">
          <div class="w-14 h-14 sm:w-16 sm:h-16 aspect-square rounded-xl overflow-hidden shadow-md border border-brand-border group-hover:border-brand-red transition-all duration-200 shrink-0 bg-[#031926] flex items-center justify-center p-1">
            <img 
              src="/images/logo-square.webp" 
              alt="Logo Plombier Urgent Mouscron" 
              class="w-full h-full object-contain rounded-lg group-hover:scale-105 transition-transform duration-300" 
              width="64" 
              height="64" 
              loading="eager"
              decoding="async"
            />
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center space-x-7 font-medium text-sm text-brand-darkText" aria-label="Navigation principale">
          <a class="hover:text-brand-red transition-colors" href="/">Accueil</a>
          <a class="hover:text-brand-red transition-colors" href="/services">Services</a>
          <a class="hover:text-brand-red transition-colors" href="/locations">Zones d'intervention</a>
          <a class="hover:text-brand-red transition-colors" href="/blog">Guides & Blog</a>
          <a class="hover:text-brand-red transition-colors" href="/about">A propos</a>
          <a class="hover:text-brand-red transition-colors" href="/contact">Contact</a>
        </nav>

        <!-- Header CTA Buttons -->
        <div class="flex items-center space-x-3">
          <a class="hidden sm:flex flex-col text-right" href="tel:+32490067245">
            <span class="text-[11px] text-brand-muted font-medium">Intervention en 30 min</span>
            <span class="text-sm md:text-base font-extrabold text-brand-navy leading-tight">0490 06 72 45</span>
          </a>
          <a class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 sm:py-3 rounded-lg bg-brand-red hover:bg-brand-redHover text-white font-bold text-xs sm:text-sm shadow-md transition duration-200" href="tel:+32490067245">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
            </svg>
            Appel Express
          </a>
          <button id="mobile-nav-toggle" type="button" class="lg:hidden p-2 rounded-lg text-brand-darkText hover:bg-brand-surface focus:outline-hidden" aria-label="Ouvrir le menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-nav-menu" class="hidden lg:hidden border-t border-brand-border bg-white px-4 pt-3 pb-6 space-y-2">
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/">Accueil</a>
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/services">Services</a>
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/locations">Zones d'intervention</a>
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/blog">Guides & Blog</a>
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/about">A propos</a>
      <a class="block py-2 text-base font-semibold text-brand-darkText hover:text-brand-red" href="/contact">Contact</a>
      <div class="pt-3 border-t border-brand-border">
        <a class="w-full inline-flex items-center justify-center py-3 bg-brand-navy text-white font-bold rounded-lg text-sm" href="tel:+32490067245">
          Appeler le 0490 06 72 45
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Slot -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Global Contact Form (Every Page) using Formsubmit.co with recipient: midebzn@gmail.com -->
  {!hideGlobalContact && <GlobalContactSection />}

  <!-- Global Google Maps Location & Territory (Every Page) -->
  <GoogleMapEmbed />

  <!-- Global Trust Pillars (Every Page): Insurance, 15+ Yrs Experience, Certifications, Guarantees, Response Times -->
  <TrustGuarantees />

  <!-- Sticky Click-to-Call Buttons (Desktop / Tablet) -->
  <StickyCallButton />

  <!-- Live Chat Widget (WhatsApp) -->
  <WhatsAppLiveChat />

  <!-- Mobile Sticky Emergency Bar -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-brand-navy/95 backdrop-blur-md border-t border-white/10 p-2.5 sm:hidden flex items-center gap-2 shadow-2xl">
    <a href="tel:+32490067245" class="flex-1 bg-brand-red hover:bg-brand-redHover text-white font-extrabold py-3 px-3 rounded-lg text-xs flex items-center justify-center gap-1.5 shadow-md">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
      </svg>
      SOS Urgence 24/7
    </a>
    <a href="https://wa.me/32490067245?text=Bonjour,%20j'ai%20une%20urgence%20plomberie%20a%20Mouscron." target="_blank" rel="noopener noreferrer" class="flex-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold py-3 px-3 rounded-lg text-xs flex items-center justify-center gap-1.5 shadow-md">
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
        <path d="M12.04 2a9.9 9.9 0 00-8.48 15.06L2 22l5.09-1.52A9.94 9.94 0 1012.04 2zm5.46 12.4c-.23-.12-1.36-.67-1.57-.75-.21-.08-.36-.12-.52.12-.15.23-.6.75-.73.9-.13.15-.27.17-.5.06-.23-.12-.97-.36-1.85-1.14-.68-.61-1.15-1.36-1.28-1.59-.13-.23-.01-.35.1-.47.1-.1.23-.27.35-.4.12-.13.15-.23.23-.38.08-.15.04-.29-.02-.4-.06-.12-.52-1.25-.71-1.71-.19-.45-.38-.39-.52-.4h-.44c-.15 0-.4.06-.61.29-.21.23-.8.78-.8 1.91s.82 2.22.94 2.38c.12.15 1.62 2.48 3.95 3.48.55.24.98.38 1.32.48.55.18 1.05.15 1.45.09.44-.07 1.36-.55 1.55-1.09.19-.53.19-.99.13-1.09-.05-.1-.2-.15-.43-.27zM12.04 20.18c-1.62 0-3.2-.44-4.58-1.27l-.33-.2-3.02.9.91-2.95-.21-.34a8.26 8.26 0 1115.4-4.34 8.2 8.2 0 01-8.17 8.2z"/>
      </svg>
      Devis WhatsApp
    </a>
  </div>

  <!-- Authoritative Footer -->
  <footer class="bg-brand-darknavy text-white pt-16 pb-24 sm:pb-16 border-t border-white/10" aria-label="Pied de page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
        <!-- Brand column -->
        <div class="space-y-4">
          <div class="flex items-center space-x-3.5">
            <div class="w-11 h-11 rounded-xl overflow-hidden shadow-md border border-white/10 shrink-0 bg-[#031926] flex items-center justify-center p-0.5">
              <img 
                src="/images/logo-icon.webp" 
                alt="Logo Plombier Urgent Mouscron" 
                class="w-full h-full object-cover rounded-lg" 
                width="44" 
                height="44" 
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="text-xl font-black text-white">Plombier Urgent Mouscron</span>
          </div>
          <p class="text-sm text-gray-300 leading-relaxed">
            Plus de 15 ans d'experience a Mouscron et communes voisines. Depannage plomberie d'urgence 24h/24 et 7j/7 en 20 a 30 minutes. Artisans certifies Gaz G1/G2, PEB et VCA, agreation toutes assurances belges et devis ferme annonce avant travaux.
          </p>
          <div class="text-xs text-gray-400 space-y-1.5">
            <p>Siege local : <a href="https://maps.app.goo.gl/4C3AtbpBCvHqD56n7" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white underline transition-colors">Rue de la Royenne 45, 7700 Mouscron</a></p>
            <p>TVA 6% applicable pour batiments de plus de 10 ans</p>
          </div>
        </div>

        <!-- Services column -->
        <div>
          <h4 class="text-sm font-bold uppercase tracking-wider text-brand-red mb-4">Interventions d'urgence</h4>
          <ul class="space-y-2.5 text-sm text-gray-300">
            <li><a class="hover:text-white transition-colors" href="/services/depannage-urgence">Depannage d'urgence 24/7</a></li>
            <li><a class="hover:text-white transition-colors" href="/services/debouchage">Debouchage canalisations & WC</a></li>
            <li><a class="hover:text-white transition-colors" href="/services/detection-fuites">Detection de fuites sans casse</a></li>
            <li><a class="hover:text-white transition-colors" href="/services/chauffage-chaudieres">Chauffage & chaudieres</a></li>
            <li><a class="hover:text-white transition-colors" href="/services/installations-sanitaires">Installations sanitaires</a></li>
            <li><a class="hover:text-white transition-colors" href="/services/traitement-eau">Traitement de l'eau & adoucisseurs</a></li>
          </ul>
        </div>

        <!-- Locations column -->
        <div>
          <h4 class="text-sm font-bold uppercase tracking-wider text-brand-red mb-4">Zones desservies</h4>
          <ul class="space-y-2 text-sm text-gray-300">
            <li><a class="hover:text-white transition-colors" href="/locations/mouscron">Mouscron Centre (7700)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/luingne">Luingne (7700)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/herseaux">Herseaux (7712)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/dottignies">Dottignies (7711)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/estaimpuis">Estaimpuis & Nechin (7730)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/tourcoing">Tourcoing & Frontiere (59200)</a></li>
            <li><a class="hover:text-white transition-colors" href="/locations/comines-warneton">Comines-Warneton (7780)</a></li>
          </ul>
        </div>

        <!-- Contact & Hours -->
        <div class="space-y-4">
          <h4 class="text-sm font-bold uppercase tracking-wider text-brand-red mb-4">Contact & Permanence</h4>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-3">
            <div>
              <span class="text-xs uppercase tracking-wider text-gray-400 block">Ligne d'urgence 24h/24 & 7j/7 :</span>
              <a class="text-2xl font-black text-white hover:text-brand-red transition-colors block" href="tel:+32490067245">
                0490 06 72 45
              </a>
              <span class="text-xs text-brand-red font-semibold block pt-0.5">Arrivee en 20 a 30 minutes</span>
            </div>

            <div class="pt-2 border-t border-white/10">
              <span class="text-xs uppercase tracking-wider text-gray-400 block">Email direct :</span>
              <a class="text-xs sm:text-sm font-bold text-gray-200 hover:text-brand-red transition-colors block break-all" href="mailto:contact@plombierurgentmouscron.be">
                contact@plombierurgentmouscron.be
              </a>
            </div>

            <div class="pt-2 border-t border-white/10">
              <span class="text-xs uppercase tracking-wider text-gray-400 block">Adresse de l'atelier :</span>
              <a href="https://maps.app.goo.gl/4C3AtbpBCvHqD56n7" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-300 hover:text-white underline transition-colors block mt-0.5">
                Rue de la Royenne 45, 7700 Mouscron
              </a>
            </div>
          </div>
          <p class="text-xs text-gray-400">
            Paiements acceptes sur place: Bancontact, virement instantane, especes. Facture conforme fournie immediatement.
          </p>
        </div>
      </div>

      <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
        <p>&copy; 2026 Plombier Urgent Mouscron. Tous droits reserves. Plomberie generale et depannage sanitaire.</p>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a class="hover:text-white transition-colors" href="/blog">Guides & Blog</a>
          <a class="hover:text-white transition-colors" href="/about">Mentions legales</a>
          <a class="hover:text-white transition-colors" href="/contact">Devis gratuit</a>
          <a class="hover:text-white transition-colors" href="/locations">Plan d'intervention</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const navBtn = document.getElementById('mobile-nav-toggle');
    const navMenu = document.getElementById('mobile-nav-menu');
    if (navBtn && navMenu) {
      navBtn.addEventListener('click', () => {
        navMenu.classList.toggle('hidden');
      });
    }
  </script>
</body>
</html>
