---
// Component: StickyCallButton.astro
// Floating sticky click-to-call button on desktop & tablet
// (Mobile is handled by the bottom sticky emergency bar)
---

<aside 
  class="fixed bottom-6 left-6 z-40 hidden sm:flex items-center group" 
  aria-label="Appel rapide d'urgence"
>
  <a 
    href="tel:+32490067245" 
    class="flex items-center gap-3.5 bg-brand-navy hover:bg-brand-red text-white py-3 px-5 rounded-2xl shadow-2xl border border-white/20 transition-all duration-300 transform group-hover:scale-105"
    title="Appeler le plombier de garde"
  >
    <!-- Pulse Ring Indicator -->
    <span class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-brand-red text-white group-hover:bg-white group-hover:text-brand-red transition-colors">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-xl bg-brand-red opacity-75"></span>
      <svg class="w-5 h-5 relative z-10" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
      </svg>
    </span>

    <!-- Text info -->
    <div class="text-left">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-extrabold uppercase tracking-widest text-brand-red group-hover:text-white transition-colors">
          SOS Urgence 24/7
        </span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
      </div>
      <span class="text-base font-black tracking-tight text-white block leading-tight">
        0490 06 72 45
      </span>
      <span class="text-[10px] text-gray-300 block">
        Arrivee en 20 a 30 min
      </span>
    </div>
  </a>
</aside>
