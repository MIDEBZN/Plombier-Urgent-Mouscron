---
// Component: TrustBadgesStrip.astro
// Trust badges strip displaying verified service standards, Belgian tax conformity, and insurance assistance
// Fully compliant: zero fabricated accreditations, zero unverified certifications
---

<section class="py-12 bg-white border-y border-brand-border" aria-labelledby="trust-badges-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-red block mb-1">
        Rigueur & Conformité Légale
      </span>
      <h2 id="trust-badges-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight">
        Nos Engagements de Service à Mouscron
      </h2>
      <p class="text-xs sm:text-sm text-brand-muted mt-1">
        Prestations de plomberie et d'assainissement réalisées dans le respect des règles de l'art et de la réglementation belge.
      </p>
    </div>

    <!-- Badges Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 items-stretch">
      <!-- Badge 1: Entreprise belge -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center font-black text-xs mb-2">
          BCE
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Activité Légale</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Enregistrée en Belgique</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Conformité belge
        </span>
      </div>

      <!-- Badge 2: Devis préalable -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center font-black text-xs mb-2">
          DEVIS
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Devis Avant Travaux</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Tarif clair validé sur place</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Sans frais cachés
        </span>
      </div>

      <!-- Badge 3: Assurances -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center font-black text-xs mb-2">
          ASSUR
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Dossier Assurance</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Facture & rapport dégât des eaux</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Pièces conformes
        </span>
      </div>

      <!-- Badge 4: Normes sanitaires -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center font-black text-xs mb-2">
          NORMES
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Règles de l'Art</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Installations d'eau & évacuations</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Travail soigné
        </span>
      </div>

      <!-- Badge 5: Disponibilité 24/7 -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center font-black text-xs mb-2">
          24/7
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Permanence 24/7</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Nuits, dimanches et fériés</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Astreinte locale
        </span>
      </div>

      <!-- Badge 6: TVA Réduite 6% sous conditions -->
      <div class="p-4 rounded-2xl bg-brand-surface border border-brand-border flex flex-col items-center text-center justify-between hover:border-brand-navy transition shadow-2xs">
        <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center font-black text-xs mb-2">
          TVA
        </div>
        <div>
          <span class="text-xs font-bold text-brand-navy block">Taux TVA 6% ou 21%</span>
          <span class="text-[10px] text-brand-muted block mt-0.5">Selon éligibilité fiscale belge</span>
        </div>
        <span class="mt-2 text-[10px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
          Attestation fournie
        </span>
      </div>
    </div>
  </div>
</section>
