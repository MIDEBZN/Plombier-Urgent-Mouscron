---
// Component: GoogleMapEmbed.astro
// Interactive Google Maps Embed for Vensol Plombier Urgent Mouscron
// Displayed on all pages across the website
// Zero emojis and zero em dashes
---

<section class="py-14 sm:py-16 bg-white border-t border-brand-border" aria-labelledby="google-map-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-brand-surface rounded-3xl border border-brand-border p-6 sm:p-8 lg:p-10 shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Text & Action Column (5 cols) -->
        <div class="lg:col-span-5 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-navy/5 border border-brand-navy/10 text-xs font-bold text-brand-navy">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Atelier & Depot d'Urgence Mouscron
          </div>

          <h2 id="google-map-heading" class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight">
            Notre Localisation a Mouscron
          </h2>

          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            Positionne strategiquement a Mouscron, notre atelier centralise nos vehicules d'astreinte equipes de materiel hydrocureur, cameras d'inspection thermique et pieces detachees sanitaires. Cette proximite garantit une arrivee chez vous en 20 a 30 minutes 24h/24 et 7j/7.
          </p>

          <div class="p-4 rounded-2xl bg-white border border-brand-border space-y-2.5 text-xs text-brand-darkText shadow-xs">
            <div class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-brand-red shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div>
                <strong class="text-brand-navy block">Adresse physique :</strong>
                <a 
                  href="https://maps.app.goo.gl/4C3AtbpBCvHqD56n7" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-brand-navy hover:text-brand-red font-semibold underline transition-colors"
                >
                  Rue de la Royenne 45, 7700 Mouscron, Belgique
                </a>
              </div>
            </div>

            <div class="flex items-start gap-2.5 pt-2 border-t border-brand-border">
              <svg class="w-4 h-4 text-brand-red shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
              </svg>
              <div>
                <strong class="text-brand-navy block">Permanence 24h/24 & 7j/7 :</strong>
                <a href="tel:+32465275753" class="text-brand-red hover:underline font-bold">
                  0465 27 57 53
                </a>
              </div>
            </div>

            <div class="flex items-start gap-2.5 pt-2 border-t border-brand-border">
              <svg class="w-4 h-4 text-brand-red shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <strong class="text-brand-navy block">Delai moyen d'arrivee :</strong>
                <span class="text-brand-muted">20 a 30 minutes a Mouscron, Luingne, Herseaux, Dottignies</span>
              </div>
            </div>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <a 
              href="https://maps.app.goo.gl/4C3AtbpBCvHqD56n7" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-brand-navy hover:bg-brand-navyHover text-white font-bold text-xs shadow-md transition gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
              Ouvrir dans Google Maps
            </a>
            <a 
              href="tel:+32465275753" 
              class="inline-flex items-center justify-center px-5 py-3 rounded-xl bg-brand-red hover:bg-brand-redHover text-white font-bold text-xs shadow-md transition gap-2"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
              </svg>
              SOS Urgence 0465 27 57 53
            </a>
          </div>
        </div>

        <!-- Google Maps Iframe Container (7 cols) -->
        <div class="lg:col-span-7">
          <div class="relative w-full h-[380px] sm:h-[440px] lg:h-[480px] rounded-2xl overflow-hidden border border-brand-border shadow-lg bg-gray-100">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2717.830353905832!2d3.225760976575453!3d50.758250871652635!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xa1810492d7fcc803%3A0x8016d791cb5fe57d!2sVensol%20Plombier%20Urgent%20Mouscron!5e1!3m2!1sen!2sbe!4v1790970670814!5m2!1sen!2sbe" 
              class="w-full h-full border-0" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="strict-origin-when-cross-origin"
              title="Carte interactive Google Maps - Vensol Plombier Urgent Mouscron"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
